# Python 缓存
__pycache__/
*.py[cod]
*$py.class

# 测试 / lint 缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# 覆盖率
.coverage
coverage.xml
htmlcov/

# 日志与临时文件
*.log
*.tmp
*.swp

# 构建产物
dist/
build/
*.egg-info/

# 环境变量（保留模板）
.env
.env.*
!.env.example

# 虚拟环境
.venv/
venv/

# veADK 会话数据
.adk/

# 前端依赖
node_modules/

# 操作系统与 IDE
.DS_Store
Thumbs.db
.idea/

# Git 与 Docker 元数据
.git/
.gitignore
Dockerfile*
.dockerignore
